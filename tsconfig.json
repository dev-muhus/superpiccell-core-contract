{
  "compilerOptions": {
    "lib": ["es2023"],
    "target": "es2023",
    "module": "node20",
    "types": ["node", "mocha"],
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "frontend", "artifacts", "cache", "typechain-types", "tmp"]
}
